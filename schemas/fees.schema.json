{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://third-floor.example/schemas/fees.schema.json",
  "title": "Third Floor fee file",
  "description": "One instrument, one report month: the fee table in force at that month's as-of date, read from the instrument's own prospectus filing (3F D-22). These costs are already inside the instrument's price and every return worked out from it, so they are disclosed beside the returns and never taken off them. Append-only, one file per report month, at data/_fees/<TICKER>/<YYYY-MM>.json.",
  "type": "object",
  "required": ["app", "fees_schema_version", "ticker", "role", "month", "as_of", "generated_at", "already_in_returns", "effective_date_note", "fees", "blockers"],
  "additionalProperties": false,
  "properties": {
    "app": { "const": "Third Floor" },
    "fees_schema_version": { "type": "string", "pattern": "^\\d+\\.\\d+$" },
    "ticker": { "type": "string", "pattern": "^[A-Z.]{1,6}$" },
    "role": { "enum": ["fund", "benchmark"] },
    "month": { "type": "string", "pattern": "^\\d{4}-\\d{2}$" },
    "as_of": { "type": "string", "format": "date" },
    "generated_at": { "type": "string", "format": "date-time" },
    "already_in_returns": { "const": true },
    "effective_date_note": { "type": "string", "minLength": 1 },
    "fees": {
      "description": "Yearly fractions of net assets: 0.0095 is 0.95%. Null only with a blocker saying why.",
      "type": ["object", "null"],
      "required": ["management", "distribution_12b1", "other", "acquired_funds", "gross", "waiver", "net", "source"],
      "additionalProperties": false,
      "properties": {
        "management": { "type": ["number", "null"], "minimum": 0, "maximum": 0.05 },
        "distribution_12b1": { "type": ["number", "null"], "minimum": 0, "maximum": 0.05 },
        "other": { "type": ["number", "null"], "minimum": 0, "maximum": 0.05 },
        "acquired_funds": {
          "description": "The costs of the funds this fund holds. For a fund of funds this is most of what it costs.",
          "type": ["number", "null"], "minimum": 0, "maximum": 0.05
        },
        "gross": { "type": "number", "minimum": 0, "maximum": 0.05 },
        "waiver": { "description": "Always a reduction, whatever sign the filer tagged it with.", "type": "number", "minimum": 0, "maximum": 0.05 },
        "net": { "type": "number", "minimum": 0, "maximum": 0.05 },
        "source": {
          "type": "object",
          "required": ["kind", "form", "filed", "accession", "url", "series_id", "class_id", "note"],
          "additionalProperties": false,
          "properties": {
            "kind": { "enum": ["sec_xbrl", "manual"] },
            "form": { "type": "string" },
            "filed": { "type": "string", "format": "date" },
            "accession": { "type": ["string", "null"] },
            "url": { "type": "string", "minLength": 1 },
            "series_id": { "type": ["string", "null"] },
            "class_id": { "type": ["string", "null"] },
            "note": { "type": ["string", "null"] }
          }
        }
      }
    },
    "blockers": { "type": "array", "items": { "$ref": "snapshot.schema.json#/$defs/blocker" } }
  }
}
