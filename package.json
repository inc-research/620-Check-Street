{
  "name": "third-floor",
  "version": "0.1.0",
  "private": true,
  "description": "Semibeta readings for Options-Integrated ETFs. Computed monthly in a notebook, served as a static archive.",
  "license": "MIT",
  "workspaces": [
    "packages/core",
    "packages/copy",
    "packages/web"
  ],
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "build": "tsc --build",
    "typecheck": "tsc --build --force",
    "test": "npm run test --workspaces --if-present",
    "check:vendored": "node scripts/check-vendored.mjs",
    "check:notebook": "python3 scripts/build-notebook.py --check",
    "build:notebook": "python3 scripts/build-notebook.py",
    "ingest": "node scripts/ingest-snapshots.mjs",
    "validate:data": "node scripts/validate-snapshots.mjs",
    "build:index": "node scripts/build-index.mjs",
    "check:index": "node scripts/build-index.mjs --check"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "esbuild": "^0.24.0",
    "typescript": "^5.7.2"
  }
}
